{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and onboarding data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "onboarded": { "type": "boolean" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharing": { "type": "boolean" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "Uploaded PDF or image record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "fileURL", "type", "createdAt"]
    },
    "Reminder": {
      "title": "Health Reminder",
      "description": "Medicine or appointment reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["medicine", "appointment", "generic"] },
        "completed": { "type": "boolean" },
        "days": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "title", "time"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Stores user profiles and roles"
    },
    "/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Stores medical records links"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "User's specific reminders"
    }
  }
}
